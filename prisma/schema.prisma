// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id      String @id @default(uuid())
  name    String
  badgeId Int    @unique

  jobTitle  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id], name: "EmployeeSector")

  managedSector Sector? @relation(name: "SectorManager")
}

model Sector {
  id         String   @id @default(uuid())
  nameSector String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  managerId String?   @unique
  manager   Employee? @relation(fields: [managerId], references: [id], name: "SectorManager")

  employeers Employee[] @relation(name: "EmployeeSector")
}
